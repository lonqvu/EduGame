# Copy to /opt/edugame/.env on the VPS (chmod 600). Never commit the real file.
# Make the secrets with: openssl rand -hex 24   /   openssl rand -base64 48

# --- Images (CI sets TAG to the commit it deploys) ---
IMAGE_PREFIX=ghcr.io/lonqvu/edugame
TAG=latest

# --- Site ---
# The domain, for automatic HTTPS. Before the domain points here: SITE_ADDRESS=:80,
# CORS_ALLOWED_ORIGINS=http://<VPS IP> and REFRESH_COOKIE_SECURE=false.
SITE_ADDRESS=edugame.vn
CORS_ALLOWED_ORIGINS=https://edugame.vn

# --- Database ---
DB_NAME=edugame
DB_USERNAME=edugame
DB_PASSWORD=

# --- Backend ---
JWT_SECRET=
JAVA_MAX_HEAP=768m
LOG_LEVEL_APP=INFO
# FEEDBACK_NOTIFY_TO=gopy@truong.edu.vn

# --- Mail (verification codes); a real SMTP provider, e.g. Brevo ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Lớp vui <no-reply@edugame.vn>
