# Copy to /opt/edugame/.env on the VPS (chmod 600). Never commit the real file.
# Make the secrets with: openssl rand -hex 24   /   openssl rand -base64 48

# --- Images (CI sets TAG to the commit it deploys) ---
IMAGE_PREFIX=ghcr.io/lonqvu/edugame
TAG=latest

# --- Site ---
# The domain, for automatic HTTPS. Before the domain points here: SITE_ADDRESS=:80 and
# CORS_ALLOWED_ORIGINS=http://<VPS IP> (the sign-in cookie drops its Secure flag by itself over plain HTTP).
SITE_ADDRESS=edugame.vn
CORS_ALLOWED_ORIGINS=https://edugame.vn

# --- Database ---
DB_NAME=edugame
DB_USERNAME=edugame
DB_PASSWORD=

# --- Backend ---
JWT_SECRET=
# "Đăng nhập với Google": OAuth client id; its Authorized JavaScript origins must list https://<SITE_ADDRESS>.
# The web image gets the same id at build time from the GitHub repository variable GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
JAVA_MAX_HEAP=768m
LOG_LEVEL_APP=INFO
# FEEDBACK_NOTIFY_TO=gopy@truong.edu.vn

# --- Mail (verification codes); a real SMTP provider, e.g. Brevo ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Lớp Vui <no-reply@edugame.vn>
