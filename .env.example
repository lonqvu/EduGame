# Copy to .env and adjust. docker-compose.yml reads this file automatically.
# The backend reads the same variable names (defaults are in backend/src/main/resources/application.yml).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edugame
DB_USERNAME=edugame
DB_PASSWORD=edugame

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=INFO

# --- Frontend (Vite only exposes variables prefixed with VITE_) ---
VITE_API_BASE_URL=http://localhost:8080/api
