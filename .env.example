# Copy to .env and adjust. docker-compose.yml reads this file automatically.
# The backend reads the same variable names (defaults are in backend/src/main/resources/application.yml).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edugame
DB_USERNAME=edugame
DB_PASSWORD=edugame

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=INFO
# Access token signing key, at least 32 bytes. The dev profile has its own default; required otherwise.
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=15m
# Refresh token cookie / sign-in session: idle lifetime with and without "Ghi nhớ đăng nhập".
# REFRESH_REMEMBER_TTL=30d
# REFRESH_SESSION_TTL=12h
# Keep true: the cookie is Secure over HTTPS (and localhost) and drops the flag by itself over plain HTTP.
# REFRESH_COOKIE_SECURE=true

# "Đăng nhập với Google": OAuth client id (Google Cloud Console > Clients, type Web application).
# Not a secret. Empty = Google sign-in off. Set VITE_GOOGLE_CLIENT_ID below to the same value.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Folder for images teachers upload (relative to where the backend runs). Default: ./data/assets
# ASSET_DIR=

# "Góp ý": addresses each new teacher feedback is mailed to, comma separated (empty: only stored, see the admin API).
# FEEDBACK_NOTIFY_TO=gopy@truong.edu.vn

# --- Mail (verification codes) ---
# Defaults send to Mailpit from docker-compose (UI: http://localhost:8025). Production: a real SMTP provider.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_STARTTLS=false
# MAIL_FROM=Lớp Vui <no-reply@edugame.local>

# --- Frontend (Vite only exposes variables prefixed with VITE_) ---
VITE_API_BASE_URL=http://localhost:8080/api
# Same as GOOGLE_CLIENT_ID; empty: the Google button says "coming soon".
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
