# SITE_ADDRESS: the domain (edugame.vn) to get HTTPS automatically, or ":80" for plain HTTP by IP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		# Uploads: spring.servlet.multipart.max-request-size.
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# Vite's hashed files (flat in /assets) never change. The pictures and sounds of public/assets live in folders
		# under /assets and keep their names when redrawn, so they are checked again like index.html.
		@hashed path_regexp ^/assets/[^/]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		# Routes of the app get index.html. A missing file under /assets is a 404, not the app's page: served in place of
		# a picture, the page would be cached as that picture.
		@page {
			not path /assets/*
			file {
				try_files {path} /index.html
			}
		}
		rewrite @page {file_match.relative}
		file_server
	}
}
