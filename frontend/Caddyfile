# SITE_ADDRESS: the domain (edugame.vn) to get HTTPS automatically, or ":80" for plain HTTP by IP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		# Uploads: spring.servlet.multipart.max-request-size.
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# Vite's hashed files never change; index.html must be checked on every visit.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
